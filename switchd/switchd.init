#!/bin/sh /etc/rc.common
# switchd — steering supervisor (morok <-> vanyavpn failover).
# Starts late: both backends must be settled (vanya START=19, morok usual).
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance switchd
	procd_set_param command /usr/sbin/switchd run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

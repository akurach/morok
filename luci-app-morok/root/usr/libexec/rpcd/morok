#!/usr/bin/ucode
// Morok rpcd backend — ubus-объект "morok" через legacy exec-протокол
// (rpcd вызывает: `morok list` и `morok call <method>`, аргументы — JSON на stdin).
// Живые метрики (задержки, выбранный urltest-ом outbound) берём из
// Clash API sing-box (127.0.0.1:9090); если sing-box не запущен —
// честно отдаём состояние "down", а не мнимые данные.

'use strict';

import { cursor } from 'uci';
import * as fs from 'fs';

const CONF = 'morok';
const CLASH_API = 'http://127.0.0.1:9090';

function uc() {
	let c = cursor();
	c.load(CONF);
	return c;
}

// json() на невалидном вводе бросает ФАТАЛЬНУЮ ошибку (убивает весь
// rpcd-вызов с "No response") — внешние данные парсим только так
function safe_json(s) {
	let r = null;
	try { r = json(s); } catch (e) { r = null; }
	return r;
}

function http_get(url, timeout) {
	let p = fs.popen(sprintf('curl -s -m %d %s 2>/dev/null', timeout, url));
	if (!p) return null;
	let body = p.read('all');
	p.close();
	if (!body || body == '') return null;
	return safe_json(body);
}

// engine-aware: globals.engine (sing-box|xray, default sing-box);
// живым считается процесс выбранного движка (Wave 3.2)
function morok_engine() {
	let c = uc();
	let e = c.get(CONF, 'globals', 'engine');
	return (e == 'xray') ? 'xray' : 'sing-box';
}

function sb_running() {
	let name = (morok_engine() == 'xray') ? 'xray' : 'sing-box';
	let p = fs.popen('pidof ' + name);
	let pid = p ? p.read('line') : '';
	if (p) p.close();
	return pid != null && pid != '';
}

function clash_delays() {
	let out = {};
	let proxies = http_get(CLASH_API + '/proxies', 2);
	if (!proxies || !proxies.proxies) return out;
	for (let name, item in proxies.proxies) {
		if (item.history && length(item.history) > 0) {
			let last = item.history[length(item.history) - 1];
			if (last.delay > 0) out[name] = last.delay;
		}
	}
	return out;
}

function read_globals(c) {
	return c.get_all(CONF, 'globals') || {};
}

function read_fallback(c) {
	let fb = c.get_all(CONF, 'fallback') || {};
	return {
		enabled: fb.enabled == '1',
		test_url: fb.test_url || '',
		test_interval: int(fb.test_interval || 10),
		fail_threshold: int(fb.fail_threshold || 3),
		auto_return: fb.auto_return == '1',
		return_delay: int(fb.return_delay || 60),
		kill_switch: fb.kill_switch || 'kill',
		chain: type(fb.chain) == 'array' ? fb.chain : (fb.chain ? [ fb.chain ] : [])
	};
}

function read_nodes(c) {
	let out = [];
	c.foreach(CONF, 'node', function(s) {
		let n = {
			id: s['.name'],
			label: s.label || s['.name'],
			group: s.group || 'Manual',
			type: s.type || 'unknown',
			server: s.server || '',
			port: s.port || '',
			enabled: s.enabled == '1',
			reality: s.reality == '1',
			origin: s.origin || ''
		};
		// awg (Wave 3.1): фронту нужны поля интерфейса для просмотра/правки
		if (n.type == 'awg') {
			for (let f in [ 'private_key', 'peer_public_key', 'preshared_key',
					'endpoint', 'jc', 'jmin', 'jmax', 's1', 's2', 's3', 's4',
					'h1', 'h2', 'h3', 'h4', 'mtu', 'keepalive' ])
				n[f] = s[f] || '';
			n.address = type(s.address) == 'array' ? s.address
				: (s.address ? [ s.address ] : []);
		}
		push(out, n);
	});
	return out;
}

function read_rules(c) {
	let out = [];
	c.foreach(CONF, 'rule', function(s) {
		push(out, {
			id: s['.name'],
			label: s.label || '',
			match_type: s.match_type || 'custom',
			match: type(s.match) == 'array' ? s.match : (s.match ? [ s.match ] : []),
			source: s.source || '',
			action: s.action || 'proxy',
			enabled: s.enabled == '1'
		});
	});
	return out;
}

function read_sources(c) {
	let out = [];
	c.foreach(CONF, 'source', function(s) {
		push(out, {
			id: s['.name'],
			label: s.label || s['.name'],
			url: s.url || '',
			enabled: s.enabled == '1',
			update_interval: int(s.update_interval || 0)
		});
	});
	return out;
}

// ---------- Wave 1: устройства, лог, сторож ----------

function bin_running(name) {
	let p = fs.popen('pidof ' + name);
	let pid = p ? p.read('line') : '';
	if (p) p.close();
	return pid != null && pid != '';
}

// AmneziaWG (Wave 3.1): тип ноды awg доступен только при установленных
// kmod-amneziawg (модуль на диске или загружен) и amneziawg-tools (awg)
function awg_kmod_present() {
	let p = fs.popen("ls /lib/modules/*/amneziawg.ko 2>/dev/null | head -1; lsmod 2>/dev/null | awk '$1==\"amneziawg\"{print $1}' | head -1");
	if (!p) return false;
	let out = p.read('all');
	p.close();
	return out != null && replace(out, /\s+/g, '') != '';
}

function awg_available() {
	return awg_kmod_present() && fs.stat('/usr/bin/awg') != null;
}

// /tmp/dhcp.leases: "expiry mac ip hostname clientid"
function read_dhcp_leases() {
	let out = {};
	let raw = fs.readfile('/tmp/dhcp.leases');
	if (!raw) return out;
	let now = time();
	for (let line in split(raw, '\n')) {
		let f = split(line, ' ');
		if (length(f) < 4 || f[1] == '') continue;
		let mac = lc(f[1]);
		out[mac] = {
			ip: f[2],
			hostname: (f[3] == '*') ? '' : f[3],
			lease_valid: int(f[0]) > now
		};
	}
	return out;
}

// ip neigh: "ip dev X lladdr mac STATE" (FAILED-строки без lladdr пропускаем)
function read_neigh() {
	let out = {};
	let p = fs.popen('ip neigh show 2>/dev/null');
	if (!p) return out;
	let raw = p.read('all');
	p.close();
	if (!raw) return out;
	for (let line in split(raw, '\n')) {
		let f = split(line, ' ');
		if (length(f) < 4) continue;
		let mac = null;
		for (let i = 0; i < length(f) - 1; i++) {
			if (f[i] == 'lladdr') { mac = lc(f[i + 1]); break; }
		}
		if (!mac) continue;
		let state = f[length(f) - 1];
		out[mac] = { ip: f[0], ok: (state != 'FAILED' && state != 'INCOMPLETE') };
	}
	return out;
}

function dev_online(mac, leases, neigh) {
	if (neigh[mac] && neigh[mac].ok) return true;
	if (leases[mac] && leases[mac].lease_valid) return true;
	return false;
}

function valid_mac(mac) {
	return mac != null && match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/) != null;
}

function reload_async() {
	fs.popen('/etc/init.d/morok reload >/dev/null 2>&1 &');
}

// ---------- Wave 2: диагностика, бэкап, компоненты ----------

const BIN_DIR = '/usr/lib/morok/bin';
const LIST_DIR = '/var/etc/morok/lists';
const SRS_DIR = '/usr/share/morok/rulesets';
const SB_JSON = '/var/etc/morok/sing-box.json';
const OUT_DIR_XRAY = '/var/etc/morok/xray.json';
// все известные типы секций — для backup/restore (foreach с null-типом
// работает, но явный список защищает от мусора и будущих сюрпризов)
const SECTION_TYPES = [ 'globals', 'fallback', 'antidpi', 'node',
	'subscription', 'rule', 'device', 'source', 'component' ];
// вендорные бинари, которые умеем показывать даже без UCI-секции component
// (роутер обновлён файлами, а конфиг ещё старый)
const KNOWN_BINS = [ 'sing-box', 'nfqws2', 'xray', 'byedpi' ];

function sh(cmd) {
	// stdout команды целиком (stderr глушим); null если не запустилась
	let p = fs.popen(cmd + ' 2>/dev/null');
	if (!p) return null;
	let out = p.read('all');
	p.close();
	return out;
}

function sh_rc(cmd) {
	// только код возврата
	let p = fs.popen(cmd + ' >/dev/null 2>&1; echo -n $?');
	if (!p) return 255;
	let out = p.read('all');
	p.close();
	return int(out);
}

function sh_full(cmd) {
	// { out, rc } — и вывод, и код возврата
	let p = fs.popen(cmd + ' 2>&1; echo -n __RC__$?');
	if (!p) return { out: '', rc: 255 };
	let out = p.read('all') || '';
	p.close();
	let pos = rindex(out, '__RC__');
	if (pos < 0) return { out: out, rc: 255 };
	return { out: substr(out, 0, pos), rc: int(substr(out, pos + 6)) };
}

function trim(s) {
	if (s == null) return '';
	return replace(replace(s, /^\s+/, ''), /\s+$/, '');
}

function has_suffix(s, suf) {
	if (length(s) < length(suf)) return false;
	return substr(s, length(s) - length(suf)) == suf;
}

// domain_suffix-семантика sing-box: pattern "b.com" матчит и "a.b.com"
function domain_match(domain, pat) {
	if (domain == pat) return true;
	return has_suffix(domain, '.' + pat);
}

function valid_domain(d) {
	return d != null && length(d) > 0 && length(d) < 253 &&
		match(d, /^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$/) != null;
}

function sb_bin() {
	if (morok_engine() == 'xray') {
		if (fs.stat(BIN_DIR + '/xray')) return BIN_DIR + '/xray';
		return '/usr/bin/xray';
	}
	if (fs.stat(BIN_DIR + '/sing-box')) return BIN_DIR + '/sing-box';
	return '/usr/bin/sing-box';
}

// команда валидации конфига выбранного движка
function core_check_cmd() {
	if (morok_engine() == 'xray')
		return 'XRAY_LOCATION_ASSET=/var/etc/morok/geo ' + sb_bin() +
			' run -test -config ' + OUT_DIR_XRAY;
	return sb_bin() + ' check -c ' + SB_JSON;
}

// домен для DNS-пробы: первый валидный из включённых custom-правил
// (заведомо «интересный» — юзер сам его внёс), фоллбэк — rutracker.org
function diag_probe_domain(c) {
	let d = '';
	c.foreach(CONF, 'rule', function(s) {
		if (d != '') return;
		if (s.enabled != '1' || s.match_type != 'custom') return;
		let mm = type(s.match) == 'array' ? s.match : (s.match ? [ s.match ] : []);
		for (let m in mm) {
			m = lc(replace(m, /\*/g, ''));
			m = replace(m, /^\.+|\.+$/g, '');
			if (valid_domain(m)) { d = m; break; }
		}
	});
	if (d == '') d = 'rutracker.org';
	return d;
}

function dig_a(domain, server) {
	let out = sh(sprintf('dig +short +time=3 +tries=1 %s @%s', domain, server));
	if (!out) return [];
	let ips = [];
	for (let line in split(out, '\n')) {
		line = trim(line);
		if (match(line, /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/)) push(ips, line);
	}
	return ips;
}

function step(id, label, status, detail, fix) {
	let s = { id: id, label: label, status: status, detail: detail };
	if (fix != null && fix != '') s.fix = fix;
	return s;
}

// версия бинаря: sing-box понимает `version`, остальные — `--version`;
// из первой строки выдёргиваем первую версиёобразную последовательность
function bin_version(path, name) {
	let out = null;
	if (name == 'sing-box') out = sh(path + ' version');
	if (!out || out == '') out = sh(path + ' --version');
	if (!out || out == '') out = sh(path + ' version');
	if (!out) return '';
	let line = split(out, '\n')[0];
	let m = match(line, /[0-9]+\.[0-9]+(\.[0-9]+)*/);
	return m ? m[0] : '';
}

function bin_sha256(path) {
	let out = sh('sha256sum ' + path);
	if (!out || out == '') return '';
	return split(out, ' ')[0];
}

function valid_bin_path(path) {
	// только наш вендорный каталог — никаких произвольных путей из UCI
	return path != null && substr(path, 0, length(BIN_DIR) + 1) == BIN_DIR + '/' &&
		index(substr(path, length(BIN_DIR) + 1), '/') < 0;
}

// ---------- test_nodes: кэш и разбор результатов ----------

const TEST_DIR = '/var/etc/morok/test.d';
const TEST_CACHE = '/var/etc/morok/node_test.json';

// строка "<tcp_ms|-> <url_ms|->" от test_nodes.sh
function read_test_result(id) {
	let r = { tcp_ms: null, url_ms: null };
	if (match(id, /^[A-Za-z0-9_.-]+$/) == null) return r;
	let raw = fs.readfile(TEST_DIR + '/' + id + '.res');
	if (!raw) return r;
	let f = split(trim(raw), /\s+/);
	if (length(f) >= 1 && match(f[0], /^[0-9]+$/) != null) r.tcp_ms = int(f[0]);
	if (length(f) >= 2 && match(f[1], /^[0-9]+$/) != null) r.url_ms = int(f[1]);
	return r;
}

function read_test_cache() {
	let raw = fs.readfile(TEST_CACHE);
	if (!raw) return {};
	let j = safe_json(raw);
	if (!j || type(j.data) != 'object') return {};
	return j.data;
}

// ---------- компоненты: кэш sha256 по mtime, поиск секции, версии ----------

const COMP_CACHE = '/var/etc/morok/comp_cache.json';

// ---------- Wave 4: канал самообновления приложения и маркет пресетов ----------

const APP_UPDATE_SH = '/usr/share/morok/app_update.sh';
const DEFAULT_APP_CHANNEL = 'https://cdn.jsdelivr.net/gh/akurach/morok@main/channel/app.json';
const PRESETS_BUILTIN = '/usr/share/morok/presets.json';
const MARKET_CACHE = '/var/etc/morok/market_cache.json';
const MARKET_TTL = 21600;

function app_channel_url(c) {
	let u = c.get(CONF, 'globals', 'app_channel');
	if (u == null || u == '') u = DEFAULT_APP_CHANNEL;
	return u;
}

// каталог маркета живёт рядом с манифестом канала: …/channel/app.json →
// …/channel/presets.json (урок 19: rindex возвращает >= 0, проверяем числом)
function market_catalog_url(c) {
	let u = app_channel_url(c);
	let pos = rindex(u, '/');
	if (pos < 0) return null;
	return substr(u, 0, pos + 1) + 'presets.json';
}

// минимальная валидация каталога: битые записи выкидываем, а не отдаём UI
function market_validate(j) {
	if (type(j) != 'object' || type(j.presets) != 'array') return null;
	let out = [];
	for (let p in j.presets) {
		if (type(p) != 'object' || type(p.id) != 'string' || type(p.label) != 'string')
			continue;
		if (type(p.rules) != 'array' || length(p.rules) == 0)
			continue;
		push(out, p);
	}
	if (length(out) == 0) return null;
	return { presets: out };
}

// sha256 бинаря — дорого (десятки МБ); кэшируем по mtime в tmpfs,
// пишем файл только когда что-то реально пересчитали
function bin_sha256_cached(path) {
	let st = fs.stat(path);
	if (!st) return '';
	let cache = {};
	let raw = fs.readfile(COMP_CACHE);
	if (raw) {
		let j = safe_json(raw);
		if (type(j) == 'object') cache = j;
	}
	if (cache[path] && cache[path].mtime == st.mtime && cache[path].sha256 != '')
		return cache[path].sha256;
	let s = bin_sha256(path);
	cache[path] = { mtime: st.mtime, sha256: s };
	let f = fs.open(COMP_CACHE + '.tmp', 'w');
	if (f) {
		f.write(sprintf('%J', cache));
		f.close();
		fs.rename(COMP_CACHE + '.tmp', COMP_CACHE);
	}
	return s;
}

function find_component(c, name) {
	let sec = null;
	c.foreach(CONF, 'component', function(s) {
		if ((s.name || s['.name']) == name) sec = s;
	});
	return sec;
}

// a новее b? семверное сравнение по числовым компонентам
function version_newer(a, b) {
	if (a == null || a == '') return false;
	if (b == null || b == '') return true;
	let pa = split(a, '.'), pb = split(b, '.');
	let n = length(pa) > length(pb) ? length(pa) : length(pb);
	for (let i = 0; i < n; i++) {
		let x = int(pa[i] || 0), y = int(pb[i] || 0);
		if (x > y) return true;
		if (x < y) return false;
	}
	return false;
}

// внешний текст по URL (манифест канала): сначала напрямую,
// при неудаче — через локальный туннель, как в bin_update.sh
function fetch_text(url) {
	if (url == null || match(url, /^https?:\/\/[^ \t'"\\]+$/) == null)
		return null;
	let out = sh(sprintf('curl -sL -m 30 %s', url));
	if (out == null || out == '')
		out = sh(sprintf('curl -sL -m 30 -x http://127.0.0.1:7890 %s', url));
	if (out == null || out == '') return null;
	return out;
}

// ---------- reorder_rules: перемапливание состояния сторожа ----------
// guardian.state и adaptive_state.json ключуются индексом @rule[N] —
// при перестановке правил ключи надо переехать вслед за правилами,
// иначе сторож «приклеит» чужой режим к другому правилу.
function remap_rule_state(old_order, new_order) {
	let new_idx = {};
	for (let i = 0; i < length(new_order); i++)
		new_idx['' + new_order[i]] = i;
	let remap = {};
	for (let i = 0; i < length(old_order); i++)
		remap['' + i] = '' + new_idx[old_order[i]];
	// guardian.state: "@rule[N]=fails:mode:since:lastprobe"
	// (дубликаты ключей схлопываем — последнее значение побеждает)
	let gs = fs.readfile('/var/etc/morok/guardian.state');
	if (gs) {
		let bykey = {}, order = [];
		for (let line in split(gs, '\n')) {
			let m = match(line, /^@rule\[([0-9]+)\]=(.*)$/);
			if (!m) continue;
			let k = remap[m[1]] || m[1];
			if (!(k in bykey)) push(order, k);
			bykey[k] = m[2];
		}
		let out = [];
		for (let k in order)
			push(out, '@rule[' + k + ']=' + bykey[k]);
		fs.writefile('/var/etc/morok/guardian.state', join('\n', out) + (length(out) ? '\n' : ''));
	}
	// adaptive_state.json: {"N":"mode"}
	let raw = fs.readfile('/var/etc/morok/adaptive_state.json');
	let j = raw ? safe_json(raw) : null;
	if (type(j) == 'object') {
		let nj = {};
		for (let k, v in j)
			nj[remap[k] || k] = v;
		fs.writefile('/var/etc/morok/adaptive_state.json', sprintf('%J', nj));
	}
}

// ---------- диагностика: каждый шаг — отдельная функция ----------
// diagnose гоняет все по порядку, diagnose_step {id} — один (живой UI
// дёргает шаги по одному и рисует прогресс).

function diag_step_service(c, g) {
	let engine = morok_engine();
	let running = sb_running();
	let nft_ok = sh_rc('nft list table inet morok') == 0;
	if (!running)
		return step('service', 'Сервис ' + engine,
			g.enabled == '1' ? 'fail' : 'warn',
			g.enabled == '1'
				? engine + ' не запущен, хотя globals.enabled=1'
				: 'Морок выключен (globals.enabled=0)', 'service');
	if (!nft_ok)
		return step('service', 'Сервис ' + engine, 'warn',
			engine + ' жив, но nft-таблица inet morok отсутствует — tproxy не работает', 'service');
	return step('service', 'Сервис ' + engine, 'ok',
		engine + ' запущен, nft-правила на месте');
}

function diag_step_config(c, g) {
	let engine = morok_engine();
	let cfg = engine == 'xray' ? OUT_DIR_XRAY : SB_JSON;
	let cfg_exists = fs.stat(cfg) != null;
	let check_rc = cfg_exists ? sh_rc(core_check_cmd()) : 1;
	if (!cfg_exists)
		return step('config', 'Конфиг ' + engine, 'fail',
			cfg + ' не существует — генерация не отработала', 'config');
	if (check_rc != 0)
		return step('config', 'Конфиг ' + engine, 'fail',
			engine + ' отвергает ' + cfg, 'config');
	return step('config', 'Конфиг ' + engine, 'ok',
		'конфиг сгенерирован и проходит проверку движка');
}

function diag_step_tunnel(c, g) {
	if (!sb_running())
		return step('tunnel', 'Туннель', 'fail',
			'сервис не запущен — проверка невозможна', 'tunnel');
	let ip = trim(sh('curl -s -m 8 -x http://127.0.0.1:7890 https://api.ipify.org'));
	if (match(ip || '', /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) != null)
		return step('tunnel', 'Туннель', 'ok',
			'внешний IP через прокси: ' + ip);
	return step('tunnel', 'Туннель', 'fail',
		'запрос через 127.0.0.1:7890 не прошёл — нода/цепочка мертва?', 'tunnel');
}

function diag_step_dns(c, g) {
	// локальный резолвер (dnsmasq → апстрим) против прямого UDP-резолва.
	// Расхождение/пустота на проблемном домене = недостоверные ответы у
	// провайдера. LAN-клиенты при dns_hijack=1 резолвятся через
	// sing-box DNS (tproxy забирает UDP/53 раньше dnsmasq).
	let dd = diag_probe_domain(c);
	let via_router = dig_a(dd, '127.0.0.1');
	let via_direct = dig_a(dd, '223.5.5.5');
	if (length(via_router) > 0 && length(via_direct) > 0) {
		let same = false;
		for (let ip in via_router)
			if (index(join(' ', via_direct), ip) >= 0) { same = true; break; }
		if (same)
			return step('dns', 'DNS', 'ok',
				dd + ' резолвится одинаково и через роутер, и напрямую');
		return step('dns', 'DNS', 'warn',
			dd + ': ответы dnsmasq и прямого резолва расходятся (' +
			join(',', via_router) + ' vs ' + join(',', via_direct) +
			') — возможна подмена DNS у апстрима', 'dns');
	}
	if (length(via_router) == 0 && length(via_direct) > 0)
		return step('dns', 'DNS', 'warn',
			dd + ': dnsmasq (апстрим провайдера) не резолвит домен, прямой резолв — да. ' +
			'Типичная подмена ответов; LAN-клиенты ходят через sing-box DNS (hijack=' +
			(g.dns_hijack == '1' ? 'вкл' : 'ВЫКЛ — включите!') + ')', 'dns');
	if (length(via_router) > 0)
		return step('dns', 'DNS', 'warn',
			dd + ': dnsmasq отвечает, а прямой резолв 223.5.5.5 — нет (нестандартно)', 'dns');
	return step('dns', 'DNS', 'fail',
		dd + ' не резолвится ни через роутер, ни напрямую — DNS мёртв', 'dns');
}

function diag_step_dpi(c, g) {
	// TLS к googlevideo напрямую (трафик самого роутера не попадает в
	// tproxy, но postrouting-очередь nfqws2 его обрабатывает — при живом
	// движке проба идёт через него, и fail тогда означает «доставка до
	// домена сейчас не работает»)
	let engine = c.get(CONF, 'antidpi', 'engine') || 'none';
	let nfq = bin_running('nfqws2');
	let probe_out = trim(sh('curl -s -o /dev/null -m 12 -w "%{http_code} %{time_total}" https://www.googlevideo.com/generate_204'));
	let pf = split(probe_out != '' ? probe_out : '000 0', ' ');
	let pcode = pf[0];
	let ptime = (length(pf) > 1 ? pf[1] : '0') * 1;
	let via_engine = (nfq && engine == 'zapret2') ? ' (проба прошла через nfqws2 — доставка до домена не сработала)' : '';
	if (pcode == '000')
		return step('dpi', 'Доставка пакетов', 'fail',
			'TLS ClientHello к googlevideo напрямую умирает — DPI-фильтрация провайдера рвёт соединение' + via_engine, 'dpi');
	if (ptime > 3)
		return step('dpi', 'Доставка пакетов', 'warn',
			sprintf('канал напрямую деградирован: ответ googlevideo за %.1f с — вероятна деградация доставки', ptime), 'dpi');
	return step('dpi', 'Доставка пакетов', 'ok',
		sprintf('TLS к googlevideo напрямую жив (HTTP %s за %.2f с)', pcode, ptime));
}

function diag_step_antidpi(c, g) {
	let engine = c.get(CONF, 'antidpi', 'engine') || 'none';
	let nfq = bin_running('nfqws2');
	let nft_post = sh('nft list chain inet morok postrouting') || '';
	let queue_ok = index(nft_post, 'queue') >= 0;
	if (engine == 'none')
		return step('antidpi', 'Движок оптимизации', 'ok',
			'движок выключен (antidpi.engine=none)');
	if (nfq && queue_ok)
		return step('antidpi', 'Движок оптимизации', 'ok',
			'nfqws2 запущен, трафик завёрнут в NFQUEUE 200');
	if (nfq)
		return step('antidpi', 'Движок оптимизации', 'warn',
			'nfqws2 жив, но queue-правила в nft нет — трафик мимо движка', 'antidpi');
	return step('antidpi', 'Движок оптимизации', 'fail',
		'engine=' + engine + ', но nfqws2 не запущен', 'antidpi');
}

function diag_step_lists(c, g) {
	let missing = [];
	c.foreach(CONF, 'rule', function(s) {
		if (s.enabled != '1') return;
		let mt = s.match_type || 'custom';
		if (mt == 'source_list') {
			if (!fs.stat(LIST_DIR + '/' + (s.source || '') + '.json'))
				push(missing, 'список ' + (s.source || '?'));
		} else if (mt == 'geosite') {
			let mm = type(s.match) == 'array' ? s.match : (s.match ? [ s.match ] : []);
			for (let m in mm)
				if (!fs.stat(SRS_DIR + '/geosite-' + m + '.srs'))
					push(missing, 'geosite-' + m + '.srs');
		} else if (mt == 'geosite_geoip') {
			let mm = type(s.match) == 'array' ? s.match : (s.match ? [ s.match ] : []);
			for (let m in mm) {
				let f = (length(m) == 2 ? 'geoip-' : 'geosite-') + m + '.srs';
				if (!fs.stat(SRS_DIR + '/' + f)) push(missing, f);
			}
		}
	});
	if (length(missing) > 0)
		return step('lists', 'Списки и геосеты', 'warn',
			'не скачаны: ' + join(', ', missing) + ' — правила по ним молча пропускаются', 'lists');
	return step('lists', 'Списки и геосеты', 'ok',
		'все списки включённых правил на месте');
}


	test_antidpi: function(a) {
		let d = lc(a.domain || '');
		d = replace(d, /^\.+|\.+$/g, '');
		if (!valid_domain(d))
			return { ok: false, error: 'некорректный домен: ' + (a.domain || '') };
		// системный DNS роутера может быть недостоверен — резолвим через
		// DoH по туннелю (схема guardian probe), потом пробуем ПРЯМОЙ путь
		// по полученному IP: его пакеты проходят postrouting → nfqws2,
		// если движок жив
		let body = sh(sprintf("curl -s -x http://127.0.0.1:7890 -m 8 'https://1.1.1.1/dns-query?name=%s&type=A' -H 'accept: application/dns-json'", d));
		let j = body ? safe_json(body) : null;
		let ip = '';
		if (j && type(j.Answer) == 'array') {
			for (let ans in j.Answer) {
				if (ans.type == 1 && match(ans.data || '', /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) != null) {
					ip = ans.data;
					break;
				}
			}
		}
		if (ip == '')
			return {
				ok: false, ip: '', code: '000', time_ms: 0,
				note: 'DoH-резолв ' + d + ' через туннель не удался — без корректного IP проверка невозможна (системный DNS недостоверен). Проверьте, что туннель жив.'
			};
		let out = trim(sh(sprintf("curl -s -o /dev/null -m 8 -w '%%{http_code} %%{time_total}' --resolve '%s:443:%s' 'https://%s/'", d, ip, d)));
		let pf = split(out != '' ? out : '000 0', ' ');
		let code = pf[0];
		let sec = (length(pf) > 1 ? pf[1] : '0') * 1;
		let time_ms = int(sec * 1000);
		let running = bin_running('nfqws2');
		let note;
		if (code == '000') {
			note = running
				? 'Доставки нет: TLS к ' + d + ' напрямую умер, хотя nfqws2 работает — профиль не подходит. Попробуйте другой или переведите правило в proxy.'
				: 'TLS к ' + d + ' напрямую умер, и движок nfqws2 не запущен — включите движок или переведите правило в proxy.';
		} else {
			note = 'оптимизация сработала: TLS к ' + d +
				' прошёл напрямую (HTTP ' + code + ' за ' + time_ms + ' мс)';
			if (!running)
				note += '. Внимание: nfqws2 не запущен — домен, видимо, доставляется и без оптимизации';
		}
		return { ok: true, ip: ip, code: code, time_ms: time_ms, note: note };
	},

	// ---------- Сканер профилей доставки ----------

	scan_start: function(a) {
		if (scan_pid_alive())
			return { ok: false, error: 'сканирование уже идёт — дождитесь конца или остановите' };
		// домены: array | строка через запятую | дефолт
		let doms = [];
		if (type(a.domains) == 'array') doms = a.domains;
		else if (type(a.domains) == 'string' && trim(a.domains) != '')
			doms = split(a.domains, ',');
		if (length(doms) == 0) doms = [ 'youtube.com', 'googlevideo.com' ];
		if (length(doms) > 4)
			return { ok: false, error: 'не больше 4 доменов за прогон' };
		let clean = [];
		for (let d in doms) {
			d = lc(trim(d));
			d = replace(d, /^\.+|\.+$/g, '');
			if (!valid_domain(d))
				return { ok: false, error: 'некорректный домен: ' + d };
			push(clean, d);
		}
		if (!fs.stat(SCAN_PROFILES))
			return { ok: false, error: 'нет ' + SCAN_PROFILES + ' — обновите пакет' };
		let r = sh_full(SCAN_SH + ' start ' + join(',', clean));
		if (r.rc != 0)
			return { ok: false, error: trim(r.out) != '' ? trim(r.out) : 'сканер не запустился' };
		return { ok: true, total: scan_profiles_count(), domains: clean };
	},

	scan_status: function(a) {
		let raw = fs.readfile(SCAN_STATE);
		let st = raw ? safe_json(raw) : null;
		if (type(st) != 'object')
			return { running: false, done: 0, total: scan_profiles_count(), results: [] };
		// state говорит running, но прогон мёртв (роутер ребутали, kill -9) —
		// честно помечаем обрыв; lock-файл при этом мог остаться — guardian
		// молчит, но это безобидно (просто пропускает probe)
		if (st.running == true && !scan_pid_alive()) {
			st.running = false;
			st.stale = true;
			st.error = 'прогон оборвался (процесс сканера не найден)';
		}
		return st;
	},

	scan_apply: function(a) {
		if (scan_pid_alive())
			return { ok: false, error: 'сканирование ещё идёт — применять профиль рано' };
		let id = trim(a.id || '');
		if (id == '')
			return { ok: false, error: 'не передан id профиля' };
		let p = scan_profile_by_id(id);
		if (!p)
			return { ok: false, error: 'профиль не найден в батарее: ' + id };
		// %HL% → hostlist-аргумент, как делает сканер (custom-стратегия
		// в antidpi.sh подставляется как есть — hostlist указываем явно)
		let hl = fs.stat(ANTIDPI_HOSTLIST) ? '--hostlist=' + ANTIDPI_HOSTLIST : '';
		let tcp = replace(p.tcp, /%HL%/g, hl);
		let udp = replace(p.udp, /%HL%/g, hl);
		let combined = tcp;
		if (trim(udp) != '') combined += ' --new ' + udp;
		// применяем через set_antidpi: там dry-run проверка аргументов,
		// сверка lua-функций и откат UCI при провале
		let res = set_antidpi_impl({
			strategy: 'custom',
			engine: 'zapret2',
			strategy_custom: combined
		});
		if (res == null) res = { ok: false, error: 'set_antidpi не ответил' };
		res.id = p.id;
		res.label = p.label;
		return res;
	},

	scan_stop: function(a) {
		if (!scan_pid_alive())
			return { ok: false, error: 'сканирование не идёт' };
		let raw = fs.readfile(SCAN_PIDFILE);
		let pid = int(trim(raw));
		sh_rc('kill ' + pid);
		// прогон по TERM восстанавливает исходную стратегию (trap):
		// engine stop + antidpi.sh restart — это секунды, дожидаемся
		let i = 0;
		while (i < 40) {
			if (!scan_pid_alive()) break;
			sleep(500);
			i++;
		}
		if (scan_pid_alive())
			return { ok: false, error: 'сканер не остановился за 20 секунд' };
		return { ok: true, running: bin_running('nfqws2'), note: 'сканирование остановлено, исходная стратегия восстановлена' };
	},

	// ---------- Wave 2 ----------

	diagnose: function(a) {
		let c = uc();
		let g = read_globals(c);
		let steps = [];
		for (let id in DIAG_ORDER)
			push(steps, DIAG_FN[id](c, g));
		return { steps: steps };
	},

	diagnose_step: function(a) {
		let id = a.id || '';
		let fn = DIAG_FN[id];
		if (!fn)
			return { ok: false, error: 'неизвестный шаг: ' + id +
				' (доступны: ' + join(', ', DIAG_ORDER) + ')' };
		return fn(uc(), read_globals(uc()));
	},

	run_fix: function(a) {
		let id = a.id || '';
		if (id == 'service' || id == 'tunnel') {
			// синхронно: gen_config + check внутри init занимают секунды
			let r = sh_full('/etc/init.d/morok restart');
			let ok = sb_running();
			return {
				ok: ok,
				note: ok ? 'сервис перезапущен, sing-box жив'
					: 'сервис перезапущен, но sing-box не поднялся — смотрите logread'
			};
		}
		if (id == 'config') {
			let gen = morok_engine() == 'xray'
				? 'ucode /usr/share/morok/xray_gen.uc'
				: 'ucode /usr/share/morok/gen_config.uc';
			let r = sh_full(gen);
			if (r.rc != 0)
				return { ok: false, error: 'генерация конфига провалилась: ' + trim(r.out) };
			let chk = sh_rc(core_check_cmd());
			if (chk != 0)
				return { ok: false, error: 'сгенерированный конфиг не проходит проверку движка' };
			if (sb_running()) sh_rc('/etc/init.d/morok reload');
			return { ok: true, note: 'конфиг перегенерирован и валиден' };
		}
		if (id == 'dns') {
			sh_rc('/etc/init.d/dnsmasq restart');
			return { ok: true, note: 'dnsmasq перезапущен; если апстрим провайдера отравляет ответы — перезапуск не вылечит, полагаемся на sing-box DNS' };
		}
		if (id == 'dpi' || id == 'antidpi') {
			let r = sh_full('/usr/share/morok/antidpi.sh restart');
			sleep(1000);
			let ok = bin_running('nfqws2');
			return {
				ok: ok,
				note: ok ? 'движок nfqws2 перезапущен и жив'
					: 'движок не поднялся — смотрите /tmp/log/morok.log (нет бинаря/kmod-nft-queue/правил antidpi?)'
			};
		}
		if (id == 'lists') {
			let r = sh_full('/usr/share/morok/ruleset_update.sh auto');
			let ok = r.rc == 0;
			return {
				ok: ok,
				note: ok ? 'списки обновлены (auto-режим: только протухшие)'
					: 'обновление списков завершилось с ошибкой: ' + trim(r.out)
			};
		}
		return { ok: false, error: 'неизвестный fix: ' + id };
	},

	backup: function(a) {
		let c = uc();
		let dump = {};
		for (let t in SECTION_TYPES) {
			c.foreach(CONF, t, function(s) { dump[s['.name']] = s; });
		}
		return { json: sprintf('%J', dump) };
	},

	restore: function(a) {
		if (!a.json || a.json == '')
			return { ok: false, error: 'пустой json' };
		let dump = safe_json(a.json);
		if (type(dump) != 'object' || length(keys(dump)) == 0)
			return { ok: false, error: 'json не похож на бэкап morok' };
		// бэкап обязан содержать ядро конфига — иначе это не наш бэкап,
		// а что-то стороннее, и стирать рабочий конфиг ради него нельзя
		for (let req in [ 'globals', 'fallback', 'antidpi' ]) {
			if (type(dump[req]) != 'object' || dump[req]['.type'] != req)
				return { ok: false, error: 'бэкап неполный: нет обязательной секции ' + req };
		}
		let known = {};
		for (let t in SECTION_TYPES) known[t] = 1;
		// валидация структуры до любой записи
		for (let name, s in dump) {
			if (match(name, /^[A-Za-z0-9_]+$/) == null)
				return { ok: false, error: 'недопустимое имя секции: ' + name };
			if (type(s) != 'object' || type(s['.type']) != 'string' || !known[s['.type']])
				return { ok: false, error: 'секция ' + name + ': отсутствует или неизвестен .type' };
			for (let k, v in s) {
				if (substr(k, 0, 1) == '.') continue;
				if (type(v) == 'string') continue;
				if (type(v) == 'array') {
					for (let item in v)
						if (type(item) != 'string')
							return { ok: false, error: 'секция ' + name + ': список ' + k + ' содержит не строку' };
					continue;
				}
				return { ok: false, error: 'секция ' + name + ': недопустимое значение опции ' + k };
			}
		}
		// автобэкап текущего конфига (только fs, без shell)
		let cur = fs.readfile('/etc/config/morok');
		if (cur) fs.writefile('/etc/config/morok.autobak', cur);
		// пересборка строго через uci-cursor — exec-инъекций нет by design.
		// Все секции восстанавливаем именованными с прежними именами
		// (в т.ч. бывшие анонимные cfgXXXX): так не протухают ссылки
		// fallback.chain, globals.active_node, origin нод, device routes.
		let c = uc();
		let doomed = [];
		for (let t in SECTION_TYPES)
			c.foreach(CONF, t, function(s) { push(doomed, s['.name']); });
		for (let n in doomed) c.delete(CONF, n);
		for (let name, s in dump) {
			// ВНИМАНИЕ: cursor.add(conf, type, name) на ucode GL/24.x
			// молча игнорирует name и создаёт анонимную секцию —
			// именованную создаём через set(conf, name, type)
			c.set(CONF, name, s['.type']);
			for (let k, v in s) {
				if (substr(k, 0, 1) == '.') continue;
				c.set(CONF, name, k, v);
			}
		}
		c.commit(CONF);
		reload_async();
		return {
			ok: true,
			sections: length(keys(dump)),
			note: 'конфиг восстановлен, прежний сохранён в /etc/config/morok.autobak, сервис перезагружается'
		};
	},

	components: function(a) {
		let c = uc();
		let out = [];
		let covered = {};
		c.foreach(CONF, 'component', function(s) {
			let name = s.name || s['.name'];
			let path = (s.path && s.path != '') ? s.path : BIN_DIR + '/' + name;
			if (!valid_bin_path(path)) path = BIN_DIR + '/' + name;
			let exists = fs.stat(path) != null;
			let ver = exists ? bin_version(path, name) : '';
			if (ver == '') ver = s.version || '';
			push(out, {
				name: name,
				version: ver,
				path: path,
				sha256: exists ? bin_sha256_cached(path) : '',
				installed: exists,
				channel: (s.channel_url && s.channel_url != '') ? true : false
			});
			covered[name] = 1;
		});
		// бинари без UCI-секции (конфиг старше файлов пакета)
		for (let n in KNOWN_BINS) {
			if (covered[n]) continue;
			let path = BIN_DIR + '/' + n;
			if (fs.stat(path) == null) continue;
			push(out, {
				name: n,
				version: bin_version(path, n),
				path: path,
				sha256: bin_sha256_cached(path),
				installed: true,
				channel: false
			});
		}
		return { components: out };
	},

	check_update: function(a) {
		let name = a.name || '';
		if (match(name, /^[A-Za-z0-9_.-]+$/) == null)
			return { ok: false, error: 'недопустимое имя компонента' };
		let c = uc();
		let sec = find_component(c, name);
		if (!sec)
			return { ok: false, error: 'компонент не найден: ' + name };
		if (!sec.channel_url || sec.channel_url == '')
			return { ok: false, error: 'канал не настроен' };
		let body = fetch_text(sec.channel_url);
		if (body == null)
			return { ok: false, error: 'манифест канала недоступен: ' + sec.channel_url };
		let m = safe_json(body);
		if (!m || type(m) != 'object' || !m.version)
			return { ok: false, error: 'манифест не в нашем формате (нет version)' };
		let path = (sec.path && sec.path != '' && valid_bin_path(sec.path)) ? sec.path : BIN_DIR + '/' + name;
		let cur = fs.stat(path) ? bin_version(path, name) : (sec.version || '');
		return {
			name: name,
			current: cur,
			latest: '' + m.version,
			update_available: version_newer('' + m.version, cur)
		};
	},

	rollback: function(a) {
		let name = a.name || '';
		if (match(name, /^[A-Za-z0-9_.-]+$/) == null)
			return { ok: false, error: 'недопустимое имя компонента' };
		let c = uc();
		let sec = find_component(c, name);
		let path = (sec && sec.path && sec.path != '' && valid_bin_path(sec.path))
			? sec.path : BIN_DIR + '/' + name;
		let prev = BIN_DIR + '/.prev/' + name;
		if (fs.stat(prev) == null)
			return { ok: false, error: 'нет сохранённой предыдущей версии для ' + name +
				' (она появляется после первого update_component)' };
		if (fs.stat(path) == null)
			return { ok: false, error: 'текущий бинарь отсутствует: ' + path };
		// бэкап текущего → ставим .prev атомарно (cp+mv в пределах одной fs)
		let r = sh_full(sprintf('cp -p %s %s.rolltmp && cp -p %s %s.new && mv %s.new %s',
			path, prev, prev, path, path, path));
		if (r.rc != 0) {
			sh_full('rm -f ' + prev + '.rolltmp ' + path + '.new');
			return { ok: false, error: 'подмена не удалась: ' + trim(r.out) };
		}
		// рестарт по типу компонента
		let ok = true;
		if (name == 'sing-box') {
			sh_rc('/etc/init.d/morok restart');
			ok = sb_running();
		} else if (name == 'nfqws2') {
			sh_rc('/usr/share/morok/antidpi.sh restart');
			sleep(1000);
			ok = bin_running('nfqws2') || c.get(CONF, 'antidpi', 'engine') != 'zapret2';
		}
		if (!ok) {
			// сервис не поднялся на старом бинаре — возвращаем как было
			sh_full(sprintf('mv %s.rolltmp %s', prev, path));
			return { ok: false, error: 'сервис не поднялся после отката — восстановлен текущий бинарь' };
		}
		// откаченный (более новый) бинарь кладём в .prev — второй rollback
		// откатывает откат
		sh_full(sprintf('mv %s.rolltmp %s', prev, prev));
		// кэш sha256 инвалидируется сам (mtime сменился), version в UCI освежаем
		let ver = bin_version(path, name);
		if (sec && ver != '') {
			c.set(CONF, sec['.name'], 'version', ver);
			c.commit(CONF);
		}
		return { ok: true, note: sprintf('%s откачен на версию %s, сервис перезапущен', name, ver) };
	},

	update_component: function(a) {
		let name = a.name || '';
		if (match(name, /^[A-Za-z0-9_.-]+$/) == null)
			return { ok: false, error: 'недопустимое имя компонента' };
		let c = uc();
		let sec = null;
		c.foreach(CONF, 'component', function(s) {
			if ((s.name || s['.name']) == name) sec = s;
		});
		if (!sec) {
			let known = {};
			for (let n in KNOWN_BINS) known[n] = 1;
			if (known[name])
				return { ok: false, error: 'канал обновлений не настроен для ' + name + ' (нет UCI-секции component)' };
			return { ok: false, error: 'компонент не найден: ' + name };
		}
		// честный ответ, пока канала нет — не имитируем обновление
		if (!sec.channel_url || sec.channel_url == '')
			return { ok: false, error: 'канал обновлений не настроен для ' + name };
		let r = sh_full('/usr/share/morok/bin_update.sh ' + name);
		let msg = trim(r.out);
		if (r.rc == 0)
			return { ok: true, note: msg != '' ? msg : 'компонент обновлён' };
		return { ok: false, error: msg != '' ? msg : 'обновление не удалось' };
	},

	set_subscription: function(a) {
		let c = uc();
		if (!c.get_all(CONF, a.id))
			return { ok: false, error: 'подписка не найдена: ' + a.id };
		if (a.label != null && a.label != '')
			c.set(CONF, a.id, 'label', a.label);
		if (a.enabled != null)
			c.set(CONF, a.id, 'enabled', a.enabled ? '1' : '0');
		if (a.update_interval != null && int(a.update_interval) >= 0)
			c.set(CONF, a.id, 'update_interval', '' + int(a.update_interval));
		if (a.user_agent != null && a.user_agent != '')
			c.set(CONF, a.id, 'user_agent', a.user_agent);
		if (a.hwid != null)
			c.set(CONF, a.id, 'hwid', a.hwid ? '1' : '0');
		c.commit(CONF);
		return { ok: true };
	},

	check_domain: function(a) {
		let d = lc(a.domain || '');
		d = replace(d, /^\.+|\.+$/g, '');
		if (!valid_domain(d))
			return { ok: false, error: 'некорректный домен: ' + (a.domain || '') };
		// суффиксные варианты: a.b.c.com → [a.b.c.com, b.c.com, c.com];
		// до последних двух меток (голый TLD не проверяем — бессмысленно)
		let parts = split(d, '.');
		let variants = [];
		for (let i = 0; i < length(parts) - 1; i++)
			push(variants, join('.', slice(parts, i)));

		let c = uc();
		let matches = [];
		let skipped = {};
		c.foreach(CONF, 'rule', function(s) {
			if (s.enabled != '1') return;
			let mt = s.match_type || 'custom';
			let hit = false;
			if (mt == 'custom') {
				let mm = type(s.match) == 'array' ? s.match : (s.match ? [ s.match ] : []);
				for (let m in mm) {
					m = lc(replace(m, /\*/g, ''));
					m = replace(m, /^\.+|\.+$/g, '');
					if (m != '' && domain_match(d, m)) { hit = true; break; }
				}
			} else if (mt == 'source_list') {
				let src = s.source || '';
				let f = LIST_DIR + '/' + src + '.json';
				if (fs.stat(f) == null) {
					skipped[(s.label || mt) + ': список ' + src + ' не скачан'] = 1;
				} else {
					// список — однострочный JSON массива domain_suffix;
					// grep -F по '"вариант"' — точное попадание, без regex
					for (let v in variants) {
						if (sh_rc(sprintf('grep -qF \'"%s"\' %s', v, f)) == 0) {
							hit = true;
							break;
						}
					}
				}
			} else if (mt == 'final') {
				hit = true;
			} else {
				// geosite/geosite_geoip: .srs бинарный, но рядом лежат
				// текстовые source-списки (rulesets/src/<set>.txt) — точный
				// grep по суффиксным вариантам. geoip — только IP, домен не матчим.
				let sets = type(s.match) == 'array' ? s.match : (s.match ? [ s.match ] : []);
				if (length(sets) == 0 && s.source) sets = [ s.source ];
				let checked = 0;
				for (let set in sets) {
					// имена в правилах без префикса: youtube → geosite-youtube.txt
					let f = '/usr/share/morok/rulesets/src/' + set + '.txt';
					if (fs.stat(f) == null) {
						f = '/usr/share/morok/rulesets/src/geosite-' + set + '.txt';
						if (fs.stat(f) == null) continue;
					}
					checked++;
					for (let v in variants) {
						if (sh_rc(sprintf('grep -qFx \'%s\' %s', v, f)) == 0) {
							hit = true;
							break;
						}
					}
					if (hit) break;
				}
				if (!hit && checked == 0)
					skipped[(s.label || mt) + ' (' + mt + ': нет source-списка)'] = 1;
			}
			if (hit)
				push(matches, {
					rule_id: s['.name'],
					rule_label: s.label || '',
					source: mt == 'source_list' ? (s.source || '') : mt,
					action: s.action || 'proxy'
				});
		});
		let res = { matches: matches };
		let sk = keys(skipped);
		res.coverage = 'проверены: custom-правила, source_list-списки, geosite (текстовые source-листы), final-правило; НЕ проверяются: geoip (только IP)';
		if (length(sk) > 0) res.skipped = sk;
		return res;
	},

	// ---------- Wave 4 ----------

	// проверка обновления приложения: вся логика (PM-детект, semver,
	// per-arch манифест) в app_update.sh --check, который печатает
	// готовый JSON; ошибки скрипта идут текстом "ERROR: …"
	app_check: function(a) {
		try {
			let r = sh_full(APP_UPDATE_SH + ' --check');
			let j = safe_json(trim(r.out));
			if (j == null || type(j) != 'object')
				return { ok: false, error: trim(r.out) != '' ? trim(r.out)
					: 'app_update.sh --check не ответил (rc=' + r.rc + ')' };
			return j;
		} catch (e) {
			return { ok: false, error: 'app_check: ' + e };
		}
	},

	// полный цикл обновления приложения: скачивание → sha256 →
	// opkg/apk install → ожидание сервиса. Отката пакета нет by design
	// (см. заголовок app_update.sh): конфиг бэкапится до установки.
	app_update: function(a) {
		try {
			let cmd = APP_UPDATE_SH + ' update';
			if (a != null && a.force == true) cmd += ' --force';
			let r = sh_full(cmd);
			let log = trim(r.out);
			if (length(log) > 4000) log = substr(log, length(log) - 4000);
			if (r.rc != 0)
				return {
					ok: false,
					log: log,
					error: 'обновление не удалось — подробности в log'
				};
			let ver = trim(sh(APP_UPDATE_SH + ' --current'));
			return { ok: true, version: ver, log: log };
		} catch (e) {
			return { ok: false, error: 'app_update: ' + e };
		}
	},

	// маркет пресетов правил (Wave 4.2): свежий каталог с канала
	// (рядом с манифестом), кэш в tmpfs 6ч, фоллбэк на вшитый
	market: function(a) {
		try {
			let c = uc();
			let url = market_catalog_url(c);
			if (url != null) {
				let body = fetch_text(url);
				if (body != null) {
					let j = market_validate(safe_json(body));
					if (j != null) {
						let f = fs.open(MARKET_CACHE + '.tmp', 'w');
						if (f) {
							f.write(sprintf('%J', { ts: time(), data: j }));
							f.close();
							fs.rename(MARKET_CACHE + '.tmp', MARKET_CACHE);
						}
						return j;
					}
				}
				let raw = fs.readfile(MARKET_CACHE);
				let cc = raw ? safe_json(raw) : null;
				if (type(cc) == 'object' && type(cc.data) == 'object' &&
					int(cc.ts) > time() - MARKET_TTL)
					return cc.data;
			}
			let raw = fs.readfile(PRESETS_BUILTIN);
			let j = market_validate(raw ? safe_json(raw) : null);
			if (j != null) return j;
			return { presets: [] };
		} catch (e) {
			return { presets: [], error: 'market: ' + e };
		}
	},

	apply: function(a) {
		fs.popen('/etc/init.d/morok restart >/dev/null 2>&1 &');
		return { ok: true, note: 'перезапуск запущен' };
	}
};


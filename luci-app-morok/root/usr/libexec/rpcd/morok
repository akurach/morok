function read_antidpi_hostlist() {
	let raw = fs.readfile(ANTIDPI_HOSTLIST);
	if (!raw) return [];
	let out = [];
	for (let line in split(raw, '\n')) {
		line = trim(line);
		if (line != '') push(out, line);
	}
	return out;
}

// сводка сторожа по правилам оптимизации для карточки статуса:
// "YouTube, Discord, Meta — через VPN". Ключи guardian.state —
// индексы @rule[N] в порядке foreach, как в guardian_status.
function antidpi_guardian_summary(c) {
	let stmap = {};
	let raw = fs.readfile('/var/etc/morok/guardian.state');
	if (raw) {
		for (let line in split(raw, '\n')) {
			let eq = index(line, '=');
			if (eq <= 0) continue;
			stmap[substr(line, 0, eq)] = substr(line, eq + 1);
		}
	}
	let parts = [];
	let modes = {};
	let idx = -1;
	c.foreach(CONF, 'rule', function(s) {
		idx++;
		if (s.action != 'antidpi' || s.enabled != '1') return;
		let mode = 'antidpi';
		if (s.adaptive == '1') {
			let st = stmap['@rule[' + idx + ']'] || '0:antidpi:0:0';
			let f = split(st, ':');
			mode = f[1] || 'antidpi';
		}
		modes[mode] = 1;
		push(parts, (s.label || s['.name']) + ' — ' +
			(mode == 'proxy' ? 'через VPN' : 'оптимизация'));
	});
	if (length(parts) == 0)
		return { mode: 'off', state_text: 'нет включённых правил с действием «Оптимизация»' };
	let mode = 'antidpi';
	if (modes['proxy'] && modes['antidpi']) mode = 'mixed';
	else if (modes['proxy']) mode = 'proxy';
	return { mode: mode, state_text: join('; ', parts) };
}

// ---------- Сканер профилей доставки (батарея scan_profiles.txt) ----------

const SCAN_SH = '/usr/share/morok/scan_antidpi.sh';
const SCAN_STATE = '/var/etc/morok/scan_state.json';
const SCAN_PROFILES = '/usr/share/morok/scan_profiles.txt';
const SCAN_PIDFILE = '/var/etc/morok/scan.pid';

function scan_pid_alive() {
	let raw = fs.readfile(SCAN_PIDFILE);
	if (!raw) return false;
	let pid = int(trim(raw));
	if (pid <= 0) return false;
	return sh_rc('kill -0 ' + pid) == 0;
}

// профиль из батареи по id → { id, label, tcp, udp } или null
function scan_profile_by_id(want) {
	let raw = fs.readfile(SCAN_PROFILES);
	if (!raw) return null;
	for (let line in split(raw, '\n')) {
		line = trim(line);
		if (line == '' || substr(line, 0, 1) == '#') continue;
		let f = split(line, '|');
		if (length(f) < 4) continue;
		if (f[0] == want)
			return { id: f[0], label: f[1], tcp: f[2], udp: f[3] };
	}
	return null;
}

function scan_profiles_count() {
	let raw = fs.readfile(SCAN_PROFILES);
	if (!raw) return 0;
	let n = 0;
	for (let line in split(raw, '\n')) {
		line = trim(line);
		if (line != '' && substr(line, 0, 1) != '#' && index(line, '|') > 0) n++;
	}
	return n;
}

// реализация set_antidpi вынесена из таблицы методов: scan_apply
// вызывает её тоже, а из тела таблицы methods.* недоступен
// (ucode: TDZ — «can't access lexical declaration before initialization»)
function set_antidpi_impl(a) {
	let c = uc();
	let cur = c.get_all(CONF, 'antidpi');
	// секция могла отсутствовать в старом конфиге — создаём именованную
	if (cur == null) {
		c.set(CONF, 'antidpi', 'antidpi');
		cur = {};
	}
	let new_strategy = (a.strategy != null && a.strategy != '') ? a.strategy : (cur.strategy || 'youtube');
	let new_engine = (a.engine != null && a.engine != '') ? a.engine : (cur.engine || 'none');
	let known = { youtube: 1, universal: 1, custom: 1 };
	if (!known[new_strategy])
		return { ok: false, error: 'неизвестная стратегия: ' + new_strategy };
	if (new_engine != 'zapret2' && new_engine != 'none')
		return { ok: false, error: 'engine должен быть zapret2|none' };
	let new_custom = (a.strategy_custom != null) ? a.strategy_custom : (cur.strategy_custom || '');
	if (new_strategy == 'custom' && trim(new_custom) == '')
		return { ok: false, error: 'стратегия custom требует непустой strategy_custom' };
	if (length(new_custom) > 2000)
		return { ok: false, error: 'strategy_custom слишком длинный (максимум 2000 символов)' };
	if (match(new_custom, /[\r\n]/) != null)
		return { ok: false, error: 'strategy_custom должен быть одной строкой' };
	// запоминаем старые значения — при провале dry-run откатим
	let old_strategy = cur.strategy;
	let old_engine = cur.engine;
	let old_custom = cur.strategy_custom;
	c.set(CONF, 'antidpi', 'strategy', new_strategy);
	c.set(CONF, 'antidpi', 'engine', new_engine);
	if (a.strategy_custom != null)
		c.set(CONF, 'antidpi', 'strategy_custom', new_custom);
	c.commit(CONF);
	// самопроверка стратегии ДО перезапуска движка: битый custom
	// не роняет работающий движок — честная ошибка и откат UCI
	let chk = sh_full(ANTIDPI_SH + ' check');
	if (chk.rc != 0) {
		if (old_strategy == null) c.delete(CONF, 'antidpi', 'strategy');
		else c.set(CONF, 'antidpi', 'strategy', old_strategy);
		if (old_engine == null) c.delete(CONF, 'antidpi', 'engine');
		else c.set(CONF, 'antidpi', 'engine', old_engine);
		if (old_custom == null) c.delete(CONF, 'antidpi', 'strategy_custom');
		else c.set(CONF, 'antidpi', 'strategy_custom', old_custom);
		c.commit(CONF);
		let why = trim(chk.out);
		if (length(why) > 400) why = substr(why, length(why) - 400);
		return {
			ok: false,
			error: 'nfqws2 отверг аргументы стратегии — настройки откачены. ' + why
		};
	}
	sh_rc(ANTIDPI_SH + ' restart');
	sleep(1500);
	let running = bin_running('nfqws2');
	if (new_engine != 'zapret2')
		return { ok: true, running: false, note: 'движок выключен (engine=' + new_engine + ')' };
	return {
		ok: true,
		running: running,
		note: running
			? 'стратегия применена, nfqws2 работает'
			: 'стратегия валидна (dry-run прошёл), но nfqws2 не поднялся — смотрите /tmp/log/morok.log (нет включённых правил «Оптимизация»? нет kmod-nft-queue?)'
	};
}

// ---------- методы ----------

let methods = {
	status: function(a) {
		let c = uc();
		let g = read_globals(c);
		let fb = read_fallback(c);
		let engine = morok_engine();
		let running = sb_running();
		// живые задержки есть только у sing-box (Clash API); у xray
		// их нет — all_dead не вычислим, честно false
		let delays = (running && engine == 'sing-box') ? clash_delays() : {};
		let active = g.active_node || '';
		let active_label = '';
		let active_found = false;
		c.foreach(CONF, 'node', function(s) {
			if (s['.name'] == active) {
				active_label = s.label || s['.name'];
				active_found = s.enabled == '1';
			}
		});
		return {
			running: running,
			engine: engine,
			enabled: g.enabled == '1',
			mode: g.mode || 'smart',
			transparent: g.transparent == '1',
			antidpi: g.antidpi == '1',
			active_node: active,
			active_label: active_label,
			// активная нода протухла (удалена/выключена) — фронт покажет предупреждение
			active_broken: active != '' && !active_found,
			active_ping: delays[active] || 0,
			chain: fb.chain,
			kill_switch: fb.kill_switch,
			all_dead: running && engine == 'sing-box' && length(keys(delays)) == 0,
			antidpi_engine: c.get(CONF, 'antidpi', 'engine') || 'none',
			antidpi_running: bin_running('nfqws2'),
			// Wave 3.1: доступность типа ноды awg (kmod + утилита awg)
			awg_available: awg_available(),
			wizard_done: g.wizard_done == '1'
		};
	},

	nodes: function(a) {
		let c = uc();
		let delays = sb_running() ? clash_delays() : {};
		let nodes = read_nodes(c);
		let fb = read_fallback(c);
		let last = read_test_cache();
		for (let n in nodes) {
			n.ping = delays[n.id] || null;
			n.in_chain = index(join(' ', fb.chain), n.id) >= 0;
			// последние измерения из test_nodes (кэш tmpfs, tmpfs пуст
			// после ребута → null, это нормально)
			let m = last[n.id];
			n.tcp_ms = (m && m.tcp_ms != null) ? m.tcp_ms : null;
			n.url_ms = (m && m.url_ms != null) ? m.url_ms : null;
			n.dns_ok = null;
		}
		let subs = [];
		c.foreach(CONF, 'subscription', function(s) {
			push(subs, {
				id: s['.name'], label: s.label || s['.name'],
				url: type(s.url) == 'array' ? s.url : (s.url ? [ s.url ] : []),
				enabled: s.enabled == '1',
				update_interval: int(s.update_interval || 0),
				last_update: int(s.last_update || 0)
			});
		});
		return { nodes: nodes, subscriptions: subs };
	},

	rules: function(a) {
		return { rules: read_rules(uc()) };
	},

	chain: function(a) {
		let c = uc();
		return { fallback: read_fallback(c), nodes: read_nodes(c) };
	},

	sources: function(a) {
		return { sources: read_sources(uc()) };
	},

	test_nodes: function(a) {
		if (!sb_running())
			return { ok: false, error: 'sing-box не запущен' };
		// скрипт параллелит проверки по всем включённым нодам
		// (фоновые джобы + wait): суммарно ~7с вместо последовательного
		// перебора 33 нод; выключенные ноды пропускает сам
		sh('/usr/share/morok/test_nodes.sh');
		let c = uc();
		let results = [];
		let cache = {};
		c.foreach(CONF, 'node', function(s) {
			if (s.enabled != '1') return;
			let id = s['.name'];
			let m = read_test_result(id);
			let item = {
				id: id,
				tcp_ms: m.tcp_ms,
				url_ms: m.url_ms,
				// Clash API не умеет DNS-пробу через конкретный outbound —
				// честно null, а не выдуманное значение
				dns_ok: null
			};
			push(results, item);
			cache[id] = { tcp_ms: item.tcp_ms, url_ms: item.url_ms, dns_ok: null };
		});
		// кэш последних измерений — метод nodes отдаёт их без перезамера
		let f = fs.open(TEST_CACHE + '.tmp', 'w');
		if (f) {
			f.write(sprintf('%J', { ts: time(), data: cache }));
			f.close();
			fs.rename(TEST_CACHE + '.tmp', TEST_CACHE);
		}
		return {
			ok: true,
			results: results,
			note: 'dns_ok=null: Clash API sing-box не предоставляет DNS-пробу через конкретную ноду'
		};
	},

	set_node: function(a) {
		let c = uc();
		c.set(CONF, a.id, 'enabled', a.enabled ? '1' : '0');
		c.commit(CONF);
		// выключенная нода не должна оставаться в urltest-цепочке живого
		// конфига: gen_config фильтрует по enabled — применяем сразу
		reload_async();
		return { ok: true };
	},

	select_node: function(a) {
		// валидируем: нода должна существовать и быть включённой,
		// иначе gen_config проигнорирует ссылку и выбор «молча» не сработает
		let c = uc();
		let found = null;
		c.foreach(CONF, 'node', function(s) {
			if (s['.name'] == a.id) found = s;
		});
		if (!found)
			return { ok: false, error: 'нода не найдена: ' + a.id };
		if (found.enabled != '1')
			return { ok: false, error: 'нода выключена: ' + (found.label || a.id) };
		c.set(CONF, 'globals', 'active_node', a.id);
		c.commit(CONF);
		fs.popen('/etc/init.d/morok reload >/dev/null 2>&1 &');
		return { ok: true };
	},

	add_node: function(a) {
		// ручная нода: фронт (парсер share-ссылки) присылает готовый
		// sing-box outbound JSON — храним verbatim, как ноды подписки
		if (!a.label || !a.raw)
			return { ok: false, error: 'нужны label и raw' };
		let o = safe_json(a.raw);
		if (!o || !o.type)
			return { ok: false, error: 'raw не похож на outbound JSON' };
		let c = uc();
		let sid = c.add(CONF, 'node');
		c.set(CONF, sid, 'enabled', '1');
		c.set(CONF, sid, 'label', a.label);
		c.set(CONF, sid, 'group', a.group && a.group != '' ? a.group : 'Manual');
		c.set(CONF, sid, 'type', o.type);
		c.set(CONF, sid, 'origin', 'manual');
		if (o.type == 'awg') {
			// AmneziaWG (Wave 3.1): junk-параметры в sing-box/xray
			// outbound не выразить — живут UCI-опциями, интерфейс
			// поднимает awg.sh. Без kmod нода бесполезна — не заводим.
			if (!awg_available()) {
				c.delete(CONF, sid);
				return { ok: false, error: 'нода типа awg недоступна: не установлены kmod-amneziawg/amneziawg-tools' };
			}
			let endpoint = o.endpoint || '';
			let server = o.server || '', port = o.server_port || 0;
			if (endpoint != '') {
				let m = match(endpoint, /^(\[[0-9a-fA-F:.]+\]|[^:]*):?([0-9]*)$/);
				if (m) {
					server = replace(m[1], /^\[|\]$/g, '');
					if (m[2] != '') port = int(m[2]);
				}
			}
			if (!o.private_key || !o.peer_public_key || server == '' || !port) {
				c.delete(CONF, sid);
				return { ok: false, error: 'awg: нужны private_key, peer_public_key и endpoint (host:port)' };
			}
			c.set(CONF, sid, 'server', server);
			c.set(CONF, sid, 'port', '' + port);
			c.set(CONF, sid, 'endpoint', server + ':' + port);
			for (let f in [ 'private_key', 'peer_public_key', 'preshared_key',
					'jc', 'jmin', 'jmax', 's1', 's2', 's3', 's4',
					'h1', 'h2', 'h3', 'h4', 'mtu', 'keepalive' ])
				if (o[f] != null && '' + o[f] != '')
					c.set(CONF, sid, f, '' + o[f]);
			if (type(o.address) == 'array' && length(o.address) > 0) {
				let al = [];
				for (let x in o.address) push(al, '' + x);
				c.set(CONF, sid, 'address', al);
			} else if (o.address)
				c.set(CONF, sid, 'address', [ '' + o.address ]);
			else {
				c.delete(CONF, sid);
				return { ok: false, error: 'awg: нужен address (CIDR туннеля)' };
			}
		} else {
			c.set(CONF, sid, 'server', '' + (o.server || ''));
			c.set(CONF, sid, 'port', '' + (o.server_port || ''));
		}
		c.set(CONF, sid, 'raw', a.raw);
		if (o.tls && o.tls.reality && o.tls.reality.enabled)
			c.set(CONF, sid, 'reality', '1');
		c.commit(CONF);
		return { ok: true, id: sid };
	},


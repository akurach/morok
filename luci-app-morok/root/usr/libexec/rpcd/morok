	reorder_rules: function(a) {
		if (type(a.order) != 'array')
			return { ok: false, error: 'order должен быть массивом id правил' };
		let c = uc();
		let cur = [];
		c.foreach(CONF, 'rule', function(s) { push(cur, s['.name']); });
		// order обязан быть перестановкой текущего набора id —
		// иначе это не reorder, а потеря/добавка правил
		let want = {};
		for (let id in a.order) {
			id = '' + id;
			if (want[id])
				return { ok: false, error: 'дубликат в order: ' + id };
			want[id] = 1;
		}
		if (length(a.order) != length(cur))
			return { ok: false, error: 'order должен содержать все правила ровно один раз' };
		for (let id in cur)
			if (!want[id])
				return { ok: false, error: 'в order нет правила ' + id };
		// cursor.reorder(conf, section, pos): позиция внутри своего типа
		// секций; порядок foreach (а значит и gen_config) следует за ним
		for (let i = 0; i < length(a.order); i++)
			c.reorder(CONF, '' + a.order[i], i);
		c.commit(CONF);
		remap_rule_state(cur, a.order);
		reload_async();
		return { ok: true, order: a.order };
	},


	read_log: function(a) {
		let n = int(a.lines || 200);
		if (n <= 0) n = 200;
		if (n > 1000) n = 1000;
		let raw = fs.readfile('/tmp/log/morok.log');
		if (!raw || raw == '') return { log: '' };
		let lines = split(raw, '\n');
		// хвост файла обычно пустая строка после последнего \n
		let last = length(lines);
		if (last > 0 && lines[last - 1] == '') last--;
		let start = last - n;
		if (start < 0) start = 0;
		let out = [];
		for (let i = start; i < last; i++)
			push(out, lines[i]);
		return { log: join('\n', out) };
	},

	guardian_status: function(a) {
		let c = uc();
		let g = read_globals(c);
		// демон сторожа: pidfile + kill -0 (pidof не видит sh-скрипт)
		let running = false;
		let pid = trim(sh('cat /var/etc/morok/guardian.pid'));
		if (match(pid || '', /^[0-9]+$/) != null)
			running = sh_rc('kill -0 ' + pid) == 0;
		// guardian.state: "@rule[N]=fails:mode:since:lastprobe";
		// в файле исторически встречаются дубликаты — последняя строка
		// ключа побеждает (stmap перезаписывается по мере чтения)
		let stmap = {};
		let raw = fs.readfile('/var/etc/morok/guardian.state');
		if (raw) {
			for (let line in split(raw, '\n')) {
				let eq = index(line, '=');
				if (eq <= 0) continue;
				stmap[substr(line, 0, eq)] = substr(line, eq + 1);
			}
		}
		let out = [];
		let idx = -1;
		c.foreach(CONF, 'rule', function(s) {
			idx++;
			if (s.action != 'antidpi' || s.enabled != '1')
				return;
			let adaptive = s.adaptive == '1';
			let fails = 0, mode = 'antidpi', last_probe = 0;
			if (adaptive) {
				let st = stmap['@rule[' + idx + ']'] || '0:antidpi:0:0';
				let f = split(st, ':');
				fails = int(f[0] || 0);
				mode = f[1] || 'antidpi';
				last_probe = int(f[3] || 0);
			}
			let state_text = 'оптимизация';
			if (mode == 'proxy')
				state_text = 'через VPN';
			else if (adaptive && fails > 0)
				state_text = 'следим';
			push(out, {
				id: s['.name'],
				label: s.label || '',
				mode: mode,
				state_text: state_text,
				adaptive: adaptive,
				fails: fails,
				last_probe: last_probe
			});
		});
		return {
			running: running,
			engine: c.get(CONF, 'antidpi', 'engine') || 'none',
			enabled: g.antidpi == '1',
			antidpi_running: bin_running('nfqws2'),
			rules: out
		};
	},


	add_subscription: function(a) {
		if (!a.label || type(a.url) != 'array' || length(a.url) == 0)
			return { ok: false, error: 'нужны название и хотя бы одна ссылка' };
		let c = uc();
		// именованная секция: стабильный sid (origin нод, имя raw-файла),
		// не зависит от cfgXXXX/@type[N] различий между прошивками
		let slug = lc(a.label);
		slug = replace(slug, /[^a-z0-9]+/g, '_');
		slug = replace(slug, /^_+|_+$/g, '');
		if (slug == '') slug = 'sub';
		let sid = slug, n = 2;
		while (c.get(CONF, sid, 'label') != null) {
			sid = slug + '_' + n;
			n++;
		}
		// cursor.add(conf, type, name) на ucode GL/24.x игнорирует name
		// (создаёт анонимную) — именованную секцию создаём через set
		c.set(CONF, sid, 'subscription');
		c.set(CONF, sid, 'label', a.label);
		c.set(CONF, sid, 'enabled', '1');
		c.set(CONF, sid, 'url', a.url);
		c.set(CONF, sid, 'last_good_url', '');
		c.set(CONF, sid, 'user_agent', a.user_agent && a.user_agent != '' ? a.user_agent : 'sing-box');
		c.set(CONF, sid, 'hwid', a.hwid ? '1' : '0');
		c.set(CONF, sid, 'update_interval', '' + (a.update_interval || 21600));
		c.set(CONF, sid, 'update_via_proxy', '1');
		c.set(CONF, sid, 'last_update', '0');
		c.commit(CONF);
		// сразу тянем ноды в фоне
		fs.popen(sprintf('/usr/share/morok/subscribe.sh %s >/dev/null 2>&1 &', sid));
		return { ok: true, id: sid };
	},

	del_subscription: function(a) {
		let c = uc();
		if (c.get(CONF, a.id, 'label') == null)
			return { ok: false, error: 'подписка не найдена' };
		// чистим ноды этой подписки + ссылки на них
		let g = read_globals(c);
		let fb = c.get_all(CONF, 'fallback') || {};
		let chain = type(fb.chain) == 'array' ? fb.chain : [];
		let chain_dirty = false;
		let doomed = [];
		c.foreach(CONF, 'node', function(s) {
			if (s.origin == a.id) push(doomed, s['.name']);
		});
		for (let id in doomed) {
			if (g.active_node == id)
				c.set(CONF, 'globals', 'active_node', '');
			let nc = [];
			for (let n in chain) if (n != id) push(nc, n);
			if (length(nc) != length(chain)) { chain = nc; chain_dirty = true; }
			c.delete(CONF, id);
		}
		if (chain_dirty)
			c.set(CONF, 'fallback', 'chain', chain);
		c.delete(CONF, a.id);
		c.commit(CONF);
		return { ok: true, removed_nodes: length(doomed) };
	},


	devices: function(a) {
		let c = uc();
		let leases = read_dhcp_leases();
		let neigh = read_neigh();
		let out = [];
		let seen = {};
		// сконфигурированные устройства — с их маршрутами
		c.foreach(CONF, 'device', function(s) {
			let mac = lc(s.mac || '');
			if (mac == '') return;
			let l = leases[mac];
			let nb = neigh[mac];
			push(out, {
				mac: mac,
				ip: l ? l.ip : (nb ? nb.ip : ''),
				hostname: l ? l.hostname : '',
				label: s.label || '',
				route: s.route || 'follow',
				enabled: s.enabled == '1',
				online: dev_online(mac, leases, neigh)
			});
			seen[mac] = 1;
		});
		// остальные DHCP-клиенты — чтобы фронт мог назначить маршрут
		for (let mac, l in leases) {
			if (seen[mac]) continue;
			push(out, {
				mac: mac,
				ip: l.ip,
				hostname: l.hostname,
				label: '',
				route: 'follow',
				enabled: false,
				online: dev_online(mac, leases, neigh)
			});
		}
		return { devices: out };
	},


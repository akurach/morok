	set_chain: function(a) {
		if (type(a.chain) != 'array')
			return { ok: false, error: 'chain должен быть массивом id нод' };
		let c = uc();
		let have = {};
		c.foreach(CONF, 'node', function(s) { have[s['.name']] = 1; });
		let clean = [], dropped = [];
		for (let id in a.chain) {
			id = '' + id;
			if (have[id]) push(clean, id);
			else push(dropped, id);
		}
		if (length(clean) > 0)
			c.set(CONF, 'fallback', 'chain', clean);
		else
			c.delete(CONF, 'fallback', 'chain');
		c.commit(CONF);
		reload_async();
		let res = { ok: true, chain: clean };
		if (length(dropped) > 0) res.dropped = dropped;
		return res;
	},


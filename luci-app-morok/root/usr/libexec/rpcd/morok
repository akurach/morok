// ---------- диспетчер exec-протокола ----------
let cmd = length(ARGV) > 0 ? ARGV[0] : '';

if (cmd == 'list') {
	printf('%J\n', schema);
} else if (cmd == 'call') {
	let method = length(ARGV) > 1 ? ARGV[1] : '';
	let raw = fs.stdin ? fs.stdin.read('all') : fs.open('/dev/stdin').read('all');
	let args = (raw && raw != '') ? safe_json(raw) : {};
	if (type(args) != 'object') args = {};
	let fn = methods[method];
	if (fn) {
		let res = fn(args);
		printf('%J\n', res != null ? res : {});
	} else {
		printf('%J\n', { ok: false, error: 'unknown method: ' + method });
	}
}
